APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SECURE_SSL_REDIRECT=false
APP_COOKIE_SECURE=false

DATABASE_URL=postgres://dwella:dwella@localhost:5432/dwella_suite
POSTGRES_DB=dwella_suite
POSTGRES_USER=dwella
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:6379/0
# Production containers use redis://redis:6379/1, separate from Celery.
APP_CACHE_URL=

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@dwella.local
DJANGO_SUPERUSER_PASSWORD=change-me
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

VITE_APP_NAME=Dwella Suite
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
FRONTEND_URL=http://localhost:5173
OPENAPI_SERVER_URL=http://127.0.0.1:8000

# Handy Agent short-lived identity tokens. Keep the real signing secret out of Git.
HANDY_AGENT_SIGNING_SECRET=
HANDY_AGENT_ISSUER=https://api.dwella.properties
HANDY_AGENT_AUDIENCE=handy-agent
HANDY_AGENT_TOKEN_TTL_SECONDS=900
VITE_HANDY_AGENT_ENABLED=false
VITE_HANDY_AGENT_URL=
THROTTLE_HANDY_AGENT_ACTION_RATE=120/hour
THROTTLE_HANDY_AGENT_TOKEN_RATE=20/hour

# Proxies in front of the API (1 for host Nginx in production; empty locally).
APP_TRUSTED_PROXY_COUNT=
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_LOGIN_RATE=8/minute
THROTTLE_PASSWORD_RESET_RATE=3/hour
THROTTLE_2FA_RATE=10/minute
THROTTLE_BETA_APPLICATION_RATE=5/hour

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@dwella.local
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
# Beta applicant emails (welcome, countdown, beta-day sign-in). Keep false until
# EMAIL_BACKEND is real SMTP; turning it on catches up missed welcome emails.
APP_BETA_EMAILS_ENABLED=false
APP_BETA_OPEN_DATE=2026-11-18
APP_BETA_EMAIL_REPLY_TO=
MARKETING_SITE_URL=https://dwella.properties
PUBLIC_API_URL=http://localhost:8000

STORAGE_BACKEND=local
MEDIA_URL=/media/
# Optional private S3-compatible uploads. Keep local until the bucket is ready.
# Cloudflare R2 uses region auto and https://<account-id>.r2.cloudflarestorage.com.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_URL_TTL=900
# Match the S3 endpoint origin when enabling S3; image sources only.
MEDIA_CSP_ORIGIN=

# ZRA Smart Invoice (VSDC). Fake device until ZRA approves ours.
ZRA_VSDC_CLIENT=apps.integrations.zra.client.FakeVsdcClient
