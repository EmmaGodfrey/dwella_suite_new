APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SECURE_SSL_REDIRECT=false
APP_COOKIE_SECURE=false

DATABASE_URL=postgres://dwella:dwella@localhost:5432/dwella_suite
REDIS_URL=redis://localhost:6379/0

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@dwella.local
DJANGO_SUPERUSER_PASSWORD=change-me

VITE_APP_NAME=Dwella Suite
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
FRONTEND_URL=http://localhost:5173

THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_LOGIN_RATE=8/minute
THROTTLE_PASSWORD_RESET_RATE=3/hour
THROTTLE_2FA_RATE=10/minute

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@dwella.local

STORAGE_BACKEND=local
MEDIA_URL=/media/
