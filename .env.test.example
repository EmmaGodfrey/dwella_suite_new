APP_ENV=staging
APP_DEBUG=false
APP_SECRET_KEY=generate-a-unique-staging-secret
APP_ALLOWED_HOSTS=app.dwella.properties
APP_CORS_ALLOWED_ORIGINS=https://app.dwella.properties
APP_CSRF_TRUSTED_ORIGINS=https://app.dwella.properties
APP_SECURE_SSL_REDIRECT=true
APP_COOKIE_SECURE=true
APP_TRUSTED_PROXY_COUNT=1

DATABASE_URL=postgresql://dwella_test:replace-me@postgres:5432/dwella_suite_test
POSTGRES_DB=dwella_suite_test
POSTGRES_USER=dwella_test
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
APP_CACHE_URL=redis://redis:6379/1

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@dwella.properties
DJANGO_SUPERUSER_PASSWORD=replace-me
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

VITE_APP_NAME=Dwella Suite Test
VITE_BASE_PATH=/test/
VITE_API_BASE_URL=https://app.dwella.properties/test/api/v1
FRONTEND_URL=https://app.dwella.properties/test
PUBLIC_API_URL=https://app.dwella.properties/test/api
OPENAPI_SERVER_URL=https://app.dwella.properties/test

# Supplied by Handy Agent. Store the real value only in the server .env.test.
HANDY_AGENT_SIGNING_SECRET=
HANDY_AGENT_ISSUER=https://api.dwella.properties
HANDY_AGENT_AUDIENCE=handy-agent
HANDY_AGENT_TOKEN_TTL_SECONDS=900
VITE_HANDY_AGENT_ENABLED=true
VITE_HANDY_AGENT_URL=https://dwella.handyagents.wazabanda.dev/agent
THROTTLE_HANDY_AGENT_ACTION_RATE=120/hour
THROTTLE_HANDY_AGENT_TOKEN_RATE=20/hour

THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_LOGIN_RATE=8/minute
THROTTLE_PASSWORD_RESET_RATE=3/hour
THROTTLE_2FA_RATE=10/minute
THROTTLE_BETA_APPLICATION_RATE=5/hour

# Staging must never send the production beta sequence.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_FROM_ADDRESS=no-reply@dwella.properties
# With real SMTP on staging, email only reaches these test inboxes or @domains.
APP_OUTBOUND_EMAIL_ALLOWLIST=eglabs.dev@gmail.com
APP_BETA_EMAILS_ENABLED=false
APP_BETA_REGISTRATION_OPEN=false
APP_BETA_OPEN_DATE=2026-11-18
MARKETING_SITE_URL=https://dwella.properties

STORAGE_BACKEND=local
MEDIA_URL=https://app.dwella.properties/test/media/
# Use a separate private bucket and credentials from production.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_URL_TTL=900
# Off-server backups (scheduler job offsite_backups) reuse the STORAGE_S3_* bucket
# under _backups/<environment>/. Optionally use a separate bucket and key instead:
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
MEDIA_CSP_ORIGIN=
ZRA_VSDC_CLIENT=apps.integrations.zra.client.FakeVsdcClient
APP_ENVIRONMENT=test
# Explicit opt-in for test acceptance only; SMS/WhatsApp verification is not configured.
LENCO_ALLOW_UNVERIFIED_DESTINATIONS=false
